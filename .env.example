# Public Eventbrite discovery configuration (names and default knobs only; no secrets or values).
BRAVE_SEARCH_API_KEY=
EVENTBRITE_PRIVATE_TOKEN=
EVENTBRITE_EVENT_CACHE_PATH=
# freshness TTL, default 24 hours
EVENTBRITE_CACHE_HOURS=24
# retained fallback/current-window cache lifetime, default 168 hours (7 days)
EVENTBRITE_CACHE_RETENTION_HOURS=168
# Eventbrite API requests per run, hard-capped at 1000
EVENTBRITE_REQUEST_MAX=1000
# organizer/venue listing calls within the total request budget
EVENTBRITE_ENTITY_MAX=400
EVENTBRITE_TIMEOUT_SECONDS=
# current-window detail records retained for cache reuse, maximum 2000
EVENTBRITE_CACHE_MAX_RECORDS=2000
